MONGO_INITDB_ROOT_USERNAME=mongo_root_user
MONGO_INITDB_ROOT_PASSWORD=mongo_root_password
MONGO_INITDB_DATABASE=hr-core
MONGODB_BACKUP_DIRECTORY_PATH=/Users/alphared/Yandex.Disk.localized/Projects/hotel-radar/backups
MONGODB_BACKUP_HOST=127.0.0.1
MONGODB_BACKUP_PORT=27777
MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@127.0.0.1:${MONGODB_BACKUP_PORT}/${MONGO_INITDB_DATABASE}?authSource=admin

DATA_PUBLICATION_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@127.0.0.1:${MONGODB_BACKUP_PORT}/hr-public?authSource=admin
DATA_PUBLICATION_RELEASE_KEY=initial-v1
DATA_PUBLICATION_RELEASE_VERSION=

BULLMQ_REDIS_HOST_PORT=26379
BULLMQ_REDIS_HOST=127.0.0.1
BULLMQ_REDIS_PORT=26379
BULLMQ_REDIS_PASSWORD=bullmq_redis_password
BULLMQ_REDIS_DB=0

HR_CORE_ACTIVE_SLOT=blue

VALHALLA_IMAGE=ghcr.io/gis-ops/docker-valhalla/valhalla:3.5.1
VALHALLA_HOST_PORT=8002
VALHALLA_BASE_URL=http://hr-valhalla:8002
VALHALLA_DATA_DIRECTORY_PATH=./valhalla/custom_files
VALHALLA_USE_TILES_IGNORE_PBF=False
VALHALLA_FORCE_REBUILD=False
VALHALLA_SERVE_TILES=True
VALHALLA_BUILD_ELEVATION=False
VALHALLA_BUILD_ADMINS=True
VALHALLA_BUILD_TIME_ZONES=True

APIFY_TOKEN=apify_api_token
APIFY_ACTOR_ID=apify~web-scraper

OPENAI_API_KEY=sk-proj-secret-key
OPENAI_MODEL=gpt-5.2

GOV_CY_HOTELS_PAGE_URL=https://www.gov.cy/tourism/en/documents/hotels-and-other-tourist-establishments-list/
PDF_STORAGE_DIRECTORY_PATH=/opt/hr-core/data/files
PDF_TMP_DIRECTORY_PATH=/opt/hr-core/tmp/gov-cy-pdf-hotels
PDF_DOWNLOAD_TIMEOUT_MS=90000
OPENAI_RESPONSES_TIMEOUT_MS=360000
GOV_CY_PDF_PARSING_CACHE_TIME_MS=43200000
